        {
          "id": "75455940-9e94-4675-aa62-8b720e0ce492",
          "name": "Download a Country Dataset",
          "request": {
            "name": "Download a Country Dataset",
            "description": {
              "content": "Downloads one country dataset as CSV, XLSX or JSON after a same-origin token has been minted. Store postal codes as text; do not convert them to integers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "download.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "(Required) ISO 3166-1 alpha-2 country code."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "(Required) Export format."
                },
                {
                  "disabled": false,
                  "key": "t",
                  "value": "<string>",
                  "description": "(Required) Download token from /download-token.php."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/csv"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
