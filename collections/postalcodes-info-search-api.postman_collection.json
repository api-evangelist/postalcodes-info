                  "description": "(Required) Search term. Minimum 2 characters."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Optional ISO 3166-1 alpha-2 country code filter."
                },
                {
                  "disabled": false,
                  "key": "region",
